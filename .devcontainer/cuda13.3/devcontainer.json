{
  "name": "velox-dev-cuda13.3",
  "build": {
    "context": "${localWorkspaceFolder}/..",
    "dockerfile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
    "args": {
      "CUDA_VERSION": "13.3",
      "BASE": "rapidsai/devcontainers:latest-cpp-cuda13.3-ucx1.21.0-openmpi5.0.10"
    },
    "cacheFrom": [
      "ghcr.io/rapidsai/velox-testing/devcontainer:latest-cuda13.3"
    ]
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "version": "28.5.2",
      "moby": false,
      "dockerDashComposeVersion": "none"
    },
    "ghcr.io/rapidsai/devcontainers/features/rapids-build-utils:latest": {},
    "../features/local/utils": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/sshd",
    "ghcr.io/devcontainers/features/docker-outside-of-docker",
    "ghcr.io/rapidsai/devcontainers/features/rapids-build-utils",
    "../features/local/utils"
  ],
  "initializeCommand": ["/bin/bash", "${localWorkspaceFolder}/scripts/devcontainer/initialize", "${localWorkspaceFolder}/..", "${localEnv:HOME}", "13.3"],
  "workspaceFolder": "/home/coder",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/coder/velox-testing,type=bind,consistency=consistent",
  "mounts": [
    "source=${localWorkspaceFolder}/../presto,target=/home/coder/presto,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../cudf,target=/home/coder/cudf,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../rmm,target=/home/coder/rmm,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../velox,target=/home/coder/velox,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../velox-worktrees,target=/home/coder/velox-worktrees,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../velox-review-worktrees,target=/home/coder/velox-review-worktrees,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../velox/build,target=/opt/velox-build,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../velox/fb-deps,target=/opt/fb-deps,type=bind,consistency=consistent",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/dotfiles/.agents,target=/home/coder/.agents,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../.aws,target=/home/coder/.aws,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../.cache,target=/home/coder/.cache,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../.cargo,target=/home/coder/.cargo,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../.config,target=/home/coder/.config,type=bind,consistency=consistent",
    "source=${localWorkspaceFolder}/../.local/share/velox-testing-cuda13.3-venvs,target=/home/coder/.local/share/venvs,type=bind,consistency=consistent",
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/devcontainer/git-signing-key.pub,target=/run/host-services/git-signing-key.pub,type=bind,readonly",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/dotfiles,target=/home/coder/dotfiles,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/shrshi-devcontainer/.inference-nvidia.key.gpg,target=/home/coder/.inference-nvidia.key.gpg,type=bind,readonly"
  ],
  "hostRequirements": {
    "gpu": "optional"
  },
  "forwardPorts": [
    2222
  ],
  "runArgs": [
    "--rm",
    "--name", "${localEnv:USER:anon}-velox-dev-cuda13.3",
    "--pids-limit", "65536",
    "--ulimit", "nofile=500000"
  ],
  "postCreateCommand": "/bin/bash /home/coder/velox-testing/scripts/devcontainer/install-rapids-policy && /bin/bash /home/coder/velox-testing/scripts/devcontainer/post-create",
  "postStartCommand": "/bin/bash /home/coder/velox-testing/scripts/devcontainer/post-start",
  "postAttachCommand": [
    "/bin/bash",
    "-c",
    "if [ ${CODESPACES:-false} = 'true' ]; then . devcontainer-utils-post-attach-command; . rapids-post-attach-command; fi"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd"
      ],
      "settings": {
        "cmake.buildDirectory": "/opt/velox-build/${buildType}",
        "cmake.configureOnOpen": false
      }
    }
  },
  "containerEnv": {
    "BENCH_DOCKER_OWNER": "${localEnv:USER}",
    "HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "VELOX_DEPENDENCY_SOURCE": "SYSTEM",
    "SSH_AUTH_SOCK": "/ssh-agent",
    "PROMPT_COMMAND": "",
    "XDG_CONFIG_HOME": "/home/coder/.config"
  }
}
