#!/bin/bash
# Configure when needed and build libcudf, tests, and benchmarks with remote sccache.

set -euo pipefail
# shellcheck source=_devcontainer_common_utils.sh
source "$(dirname "$(readlink -f "$0")")/_devcontainer_common_utils.sh"
select_sccache_family rapids

NUM_THREADS="${BUILD_JOBS}"
CMAKE_ARGS=()
SOURCE_DIR="${HOME}/cudf/cpp"
BUILD_DIR=""
TARGET_ARGS=()

usage() {
    cat <<EOF
Usage: build-libcudf-cpp [OPTIONS] [-D<VAR>=<VALUE>]...

Build libcudf, tests, and benchmarks without installing them. Existing compatible
build trees are built incrementally without explicit reconfiguration.

Options:
  --source-dir PATH  C++ source directory (default: ~/cudf/cpp)
  --build-dir PATH   Build directory (default: <source-dir>/build/latest)
  --target TARGET    Build only this target (repeatable; default: all)
  -j, --jobs N      Number of parallel jobs (default: BUILD_JOBS from config.env)
  -D<VAR>=<VALUE>   Additional CMake cache entry
  -h, --help        Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --source-dir|--build-dir|--target|-j|--jobs|--parallel|-D)
            if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
                echo "Error: $1 requires a value" >&2
                exit 1
            fi
            ;;
    esac
    case "$1" in
        --source-dir) SOURCE_DIR="$2"; shift 2 ;;
        --build-dir) BUILD_DIR="$2"; shift 2 ;;
        --target)
            if [[ "$2" == install || "$2" == install/* ]]; then
                echo "Error: installation targets are not supported" >&2
                exit 1
            fi
            if [[ ${#TARGET_ARGS[@]} -eq 0 ]]; then
                TARGET_ARGS+=(--target)
            fi
            TARGET_ARGS+=("$2")
            shift 2
            ;;
        -j|--jobs|--parallel) NUM_THREADS="$2"; shift 2 ;;
        -j*) NUM_THREADS="${1#-j}"; shift ;;
        -D)
            case "$2" in
                BUILD_TESTS=*|BUILD_BENCHMARKS=*|CMAKE_CUDA_ARCHITECTURES=*|\
                CMAKE_C_COMPILER_LAUNCHER=*|CMAKE_CXX_COMPILER_LAUNCHER=*|\
                CMAKE_CUDA_COMPILER_LAUNCHER=*)
                    echo "Error: -D$2 is controlled by build-libcudf-cpp" >&2
                    exit 1
                    ;;
            esac
            CMAKE_ARGS+=("-D$2")
            shift 2
            ;;
        -DBUILD_TESTS=*|-DBUILD_BENCHMARKS=*|-DCMAKE_CUDA_ARCHITECTURES=*|\
        -DCMAKE_C_COMPILER_LAUNCHER=*|-DCMAKE_CXX_COMPILER_LAUNCHER=*|\
        -DCMAKE_CUDA_COMPILER_LAUNCHER=*)
            echo "Error: $1 is controlled by build-libcudf-cpp" >&2
            exit 1
            ;;
        -D*) CMAKE_ARGS+=("$1"); shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
done

if ! [[ "${NUM_THREADS}" =~ ^[0-9]+$ ]] || (( NUM_THREADS < 1 )); then
    echo "Error: build jobs must be a positive integer" >&2
    exit 1
fi

SOURCE_DIR=$(realpath -m "${SOURCE_DIR}")
BUILD_DIR=$(realpath -m "${BUILD_DIR:-${SOURCE_DIR}/build/latest}")
CACHE="${BUILD_DIR}/CMakeCache.txt"

cache_value() {
    sed -n "s/^$1:[^=]*=//p" "${CACHE}" | tail -1
}

needs_configure=false
if [[ ! -f "${CACHE}" ]]; then
    needs_configure=true
else
    cached_source=$(cache_value CMAKE_HOME_DIRECTORY)
    if [[ -z "${cached_source}" || "$(realpath -m "${cached_source}")" != "${SOURCE_DIR}" ]]; then
        echo "Error: ${CACHE} belongs to '${cached_source}', not '${SOURCE_DIR}'" >&2
        exit 1
    fi
    [[ "$(cache_value BUILD_TESTS)" == "ON" ]] || needs_configure=true
    [[ "$(cache_value BUILD_BENCHMARKS)" == "ON" ]] || needs_configure=true
    [[ "$(cache_value CMAKE_CUDA_ARCHITECTURES)" == "native" ]] || needs_configure=true
    [[ "$(cache_value CMAKE_C_COMPILER_LAUNCHER)" == "sccache" ]] || needs_configure=true
    [[ "$(cache_value CMAKE_CXX_COMPILER_LAUNCHER)" == "sccache" ]] || needs_configure=true
    [[ "$(cache_value CMAKE_CUDA_COMPILER_LAUNCHER)" == "sccache" ]] || needs_configure=true
    if [[ ${#CMAKE_ARGS[@]} -ne 0 ]]; then
        needs_configure=true
    fi
fi

configure_sccache_basedirs "${SOURCE_DIR}"
require_remote_sccache

run_remote_once() {
    sccache --zero-stats
    local command_rc=0
    "$@" || command_rc=$?
    if ! validate_remote_sccache_stats; then
        return 75
    fi
    return "${command_rc}"
}

run_remote_with_retry() {
    local command_rc=0
    run_remote_once "$@" || command_rc=$?
    if [[ "${command_rc}" == 75 ]]; then
        echo "Remote compilation failed; restarting sccache and retrying once" >&2
        restart_remote_sccache
        run_remote_once "$@"
    elif [[ "${command_rc}" != 0 ]]; then
        return "${command_rc}"
    fi
}

if [[ "${needs_configure}" == true ]]; then
    configure-libcudf-cpp --source-dir "${SOURCE_DIR}" --build-dir "${BUILD_DIR}" "${CMAKE_ARGS[@]}"
fi

run_remote_with_retry cmake --build "${BUILD_DIR}" --parallel "${NUM_THREADS}" "${TARGET_ARGS[@]}"
