#!/bin/bash
# Configure libcudf for native-architecture, remote-only compilation.

set -euo pipefail
# shellcheck source=_devcontainer_common_utils.sh
source "$(dirname "$(readlink -f "$0")")/_devcontainer_common_utils.sh"
select_sccache_family rapids

CMAKE_ARGS=()
SOURCE_DIR="${HOME}/cudf/cpp"
BUILD_DIR="${SOURCE_DIR}/build/latest"

usage() {
    cat <<EOF
Usage: configure-libcudf-cpp [-D<VAR>=<VALUE>]...

Configure libcudf with tests and benchmarks for the native CUDA architecture.
The build is not compiled or installed.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -D)
            case "$2" in
                BUILD_TESTS=*|BUILD_BENCHMARKS=*|CMAKE_CUDA_ARCHITECTURES=*|\
                CMAKE_C_COMPILER_LAUNCHER=*|CMAKE_CXX_COMPILER_LAUNCHER=*|\
                CMAKE_CUDA_COMPILER_LAUNCHER=*)
                    echo "Error: -D$2 is controlled by configure-libcudf-cpp" >&2
                    exit 1
                    ;;
            esac
            CMAKE_ARGS+=("-D$2")
            shift 2
            ;;
        -DBUILD_TESTS=*|-DBUILD_BENCHMARKS=*|-DCMAKE_CUDA_ARCHITECTURES=*|\
        -DCMAKE_C_COMPILER_LAUNCHER=*|-DCMAKE_CXX_COMPILER_LAUNCHER=*|\
        -DCMAKE_CUDA_COMPILER_LAUNCHER=*)
            echo "Error: $1 is controlled by configure-libcudf-cpp" >&2
            exit 1
            ;;
        -D*) CMAKE_ARGS+=("$1"); shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
done

require_remote_sccache

configure_once() {
    sccache --zero-stats
    local configure_rc=0
    cmake -S "${SOURCE_DIR}" -B "${BUILD_DIR}" \
        -DBUILD_TESTS=ON \
        -DBUILD_BENCHMARKS=ON \
        -DCMAKE_CUDA_ARCHITECTURES=native \
        -DCMAKE_C_COMPILER_LAUNCHER=sccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=sccache \
        -DCMAKE_CUDA_COMPILER_LAUNCHER=sccache \
        "${CMAKE_ARGS[@]}" || configure_rc=$?
    if ! validate_remote_sccache_stats; then
        return 75
    fi
    return "${configure_rc}"
}

configure_rc=0
configure_once || configure_rc=$?
if [[ "${configure_rc}" == 75 ]]; then
    echo "Remote configuration failed; restarting sccache and retrying once" >&2
    restart_remote_sccache
    configure_once
else
    exit "${configure_rc}"
fi
